---
import Base from '../layouts/Base.astro';
import { sections, sectionKeys, getEntries, entryUrl, formatDate } from '../lib/sections';

const groups = await Promise.all(
  sectionKeys.map(async (key) => ({ key, ...sections[key], entries: await getEntries(key) })),
);
---

<Base description="A public lab notebook on learning AI: notes, techniques, prompts and experiments.">
  <div slot="hero" class="hero">
    <h1 class="wordmark">jolluxlab</h1>
    <p class="lead">A public lab notebook on learning AI: what I understood, what worked, and what failed.</p>
  </div>

  {
    groups.map((group) => (
      <section class="panel">
        <h2>
          <img src={group.icon} alt="" width="36" height="36" />
          <a href={`/${group.key}/`}>{group.title}</a>
        </h2>
        <ul class="rows">
          {group.entries.slice(0, 5).map((entry) => (
            <li>
              <a href={entryUrl(entry)}>{entry.data.title}</a>
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
